e": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le08ob04re7pdf01.pdf"}]}]}], "type": "DWS", "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nRetell a Greek myth.\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le08ob04re2img01.jpg", "audiosrc": "engenn9le08ob04re2aud01", "images": [{"time": "0", "image": "engenn9le08ob04re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn9le08ob04re2img01.jpg", "id": 1, "text": "Fairy tales, myths and legends have many things in common. Often strange, magical things happen in them. Children are awed by these odd stories. They wonder if they really could've happened and what they would've done in the hero's or heroine's place.<br/><br/>They sit and weigh the choices these extraordinary people have made on their way to fight dragons, rescue princesses, or right wrongs. Those that think they could've slayed the huge fiery beast act out the deed. Those that think things might've gone differently, write an alternate version, changing the outcome."}, {"time": "34000", "image": "engenn9le08ob04re2img02.jpg", "id": 2, "text": "I would've loved to have lived in ancient Greece. Perhaps I could've seen the thousand ships launch to bring the fair Helen home from Troy. Although the war they fought would've been horrific rather than romantic, when we look back at what they wore and how they lived, we do romanticize it.<br/><br/>Imagine watching Charon as he collected the fare to cross the River Styx. Hercules took a ride on that ferry and returned! The Greeks must have believed such things could have happened."}, {"time": "63000", "image": "engenn9le08ob04re2img03.jpg", "id": 3, "text": "A friend of mine swore that a fairy came to visit her every night before she went to sleep. I myself dreamt of knights, and jousting. I would've gone back in time to join them if I could have. As an adult, I realize that the legend and the reality of life in days of yore are miles apart."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Storytelling"}, {"type": "unit_name", "content": "Tell Me Another ..."}, {"type": "position", "content": 4}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 8}, {"type": "level", "content": "B2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": " Describe hypothetical situations in written and spoken interactions according to social contexts."}, {"type": "secondary_1", "content": "Understands specific information in written texts about the different social and work contexts.  Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}, {"type": "secondary_2", "content": "Understands specific information in written texts about the different social and work contexts.  Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}, {"type": "secondary_3", "content": "Understands specific information in written texts about the different social and work contexts.  Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}, {"type": "secondary_4", "content": "Understands specific information in written texts about the different social and work contexts.  Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}, {"type": "secondary_5", "content": "Understands specific information in written texts about the different social and work contexts.  Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}, {"type": "secondary_6", "content": "Understands specific information in written texts about the different social and work contexts.  Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}, {"type": "secondary_7", "content": "Understands specific information in written texts about the different social and work contexts.  Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}, {"type": "secondary_8", "content": "Understands specific information in written texts about the different social and work contexts.  Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}]}, {"type": "background_image", "content": "engenn9le08ob04re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Using Homonyms and Homophones"}, {"type": "describer", "content": "Homonyms are made up of homophones and homographs."}, {"type": "text", "content": "A <span class=\"strong\">homophone</span> is a word that has the same sound as another word but has a different meaning and may have a different spelling."}, {"type": "text", "content": "For example:<br/><span class=\"italic\">right</span> and <span class=\"italic\">write</span><br/><span class=\"italic\">right</span> (noun) and <span class=\"italic\">right</span> (adjective)"}, {"type": "example", "content": "Children are <span class=\"strong\">awed</span> by these <span class=\"strong\">odd</span> stories.  (awed/odd)"}, {"type": "example", "content": "They sit and <span class=\"strong\">weigh</span> the choices these extraordinary people have made on their <span class=\"strong\">way</span> to fight dragons. (weigh/way)"}, {"type": "example", "content": "People have made on their way to fight dragons, rescue princesses, or <span class=\"strong\">right</span> wrongs. Those that think things might've gone differently, <span class=\"strong\">write</span> an alternate version. (right/write)"}, {"type": "example", "content": "Although the <span class=\"strong\">war</span> they fought would've been horrific rather than romantic, when we look back at what they <span class=\"strong\">wore</span> and how they lived, we do romanticize it. (war/wore)"}, {"type": "example", "content": "As an adult, I realize that the legend and the reality of life in days of <span class=\"strong\">yore</span> are miles apart. What's <span class=\"strong\">your</span> opinion? (yore/your)"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Reduction of Have in Past Modals and of Auxiliary Verbs"}, {"type": "describer", "content": "When you use auxiliary verbs like have, it is common to reduce it in conversation. <br/><br/>In English, not every word or syllable is pronounced fully."}, {"type": "text", "content": "When you reduce the sound of have it sounds like <span class=\"strong\">uv</span> or <span class=\"strong\">iv</span>."}, {"type": "text", "content": "Read each sentence in it's full form:"}, {"type": "text", "content": "I <span class=\"strong\">would have</span> loved to have lived in ancient Greece.<br/>Perhaps I <span class=\"strong\">could have</span> seen the thousand ships launch to bring the fair Helen home from Troy. <br/>The Greeks <span class=\"strong\">must have</span> believed such things could have happened."}, {"type": "text", "content": "Now read them and reduce the pronunciation of the auxiliary verb have:"}, {"type": "text", "content": "I <span class=\"strong\">would've</span> loved to have lived in ancient Greece. would_uv<br/>Perhaps I <span class=\"strong\">could've</span> seen the thousand ships launch to bring the fair Helen home from Troy. could_uv<br/>The Greeks <span class=\"strong\">must've</span> believed such things could have happened.  must-uv"}, {"type": "example", "content": "They wonder if they really could've happened and what they would've done in the hero's or heroine's place. "}, {"type": "example", "content": "Those that think they could've slayed the huge fiery beast act out the deed. "}, {"type": "example", "content": "Those that think things might've gone differently, write an alternate version, changing the outcome. "}, {"type": "example", "content": "I would've loved to have lived in ancient Greece."}, {"type": "example", "content": "Perhaps I could've seen the thousand ships launch to bring the fair Helen home from Troy. "}, {"type": "example", "content": "The war they fought would've been horrific rather than romantic."}, {"type": "example", "content": "The Greeks must have believed such things could have happened."}, {"type": "example", "content": "I would've gone back in time to join them if I could have. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to awe"}, {"type": "definition", "content": "to cause a \u200bfeeling of \u200bgreat \u200brespect \u200bmixed with \u200bfear or \u200bsurprise"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Children are awed by these odd stories."}, {"type": "audio", "content": "engenn9le08ob04aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " Describe hypothetical situations in written and spoken interactions according to social contexts."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to right wrongs"}, {"type": "definition", "content": " to make amends to somebody for something."}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Extraordinary people have made their way to fight dragons, rescue princesses, or right wrongs."}, {"type": "audio", "content": "engenn9le08ob04aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to romanticize"}, {"type": "definition", "content": "to \u200btalk about something in a way that makes it \u200bsound \u200bbetter than it really is"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example:  When we look back at what they were and how they lived, we do romanticize it."}, {"type": "audio", "content": "engenn9le08ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "fare "}, {"type": "definition", "content": "a fee paid for a journey"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Imagine watching Charon as he collected the fare to cross the River Styx. "}, {"type": "audio", "content": "engenn9le08ob04aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to swear"}, {"type": "definition", "content": "to \u200bpromise or say that you are \u200btelling the \u200btruth"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: A friend of mine swore that a fairy came to visit her every night before she went to sleep."}, {"type": "audio", "content": "engenn9le08ob04aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "knight "}, {"type": "definition", "content": "a man of high \u200bsocial \u200bposition \u200btrained to \u200bfight as a \u200bsoldier on a \u200bhorse"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I myself dreamt of knights riding their horses."}, {"type": "audio", "content": "engenn9le08ob04aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to joust"}, {"type": "definition", "content": "to \u200bfight with a \u200blance while \u200briding on a \u200bhorse, \u200bespecially as a \u200bsport"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example:  I dreamt of knights, and jousting."}, {"type": "audio", "content": "engenn9le08ob04aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to launch "}, {"type": "definition", "content": "to set something in motion"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I could've seen the thousand ships launch to bring the fair Helen home from Troy."}, {"type": "audio", "content": "engenn9le08ob04aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to be miles apart"}, {"type": "definition", "content": "being at odds with what is actually happening"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I realize that the legend and the reality of life in days of yore are miles apart."}, {"type": "audio", "content": "engenn9le08ob04aud09"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Look online or go to the library and choose a Greek myth."}, {"type": "text", "content": "Read the story and take notes."}, {"type": "text", "content": "Put the events on a timeline to help you retell the story."}, {"type": "text", "content": "Note some places where you can use sound-alike words and could've/would've."}, {"type": "text", "content": "Retell your myth to a partner, being especially careful with your pronunciation."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I find a myth and take notes."}, {"type": "text", "content": "I put the events on a timeline."}, {"type": "text", "content": "I note places where I can use homonyms and reductions like could've/would've."}, {"type": "text", "content": "I tell my myth to a partner using the timeline."}, {"type": "text", "content": "I pay special attention to pronunciation."}]}]}