ct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: \n<span class=\"bullet\">Proofread the sentence.</span> \n<span class=\"bullet\">Click on the incorrect word.</span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.\n</span> <span class=\"bullet\">Use capital letters where necessary.</span> "}]}]}, {"stimuli_ids": [], "type": "TYP", "questions": [{"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "tried to refashion"}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn9le08ob05re6aud02"}, {"type": "text", "content": "Coyote realized that he acted out of anger, so he "}]}, {"type": "post_question", "contents": {"type": "", "content": "his clay creatures."}}, {"type": "objective", "content": "secondary_8"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "the pulsing stars "}]}], "id": 1, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn9le08ob05re6aud03"}, {"type": "text", "content": "In order to give life to them, he took the light from"}]}, {"type": "post_question", "contents": {"type": "", "content": "above him."}}, {"type": "objective", "content": "secondary_8"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "powerful spirit"}]}], "id": 2, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn9le08ob05re6aud04"}, {"type": "text", "content": "This is how Coyote became a wise and"}]}, {"type": "post_question", "contents": {"type": "", "content": "."}}, {"type": "objective", "content": "secondary_8"}]}], "template_override": 1, "id": 9, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nThis is how Coyote's story ends.\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Listen to the audio. Type in the missing words.\n"}]}]}, {"stimuli_ids": [], "type": "RSLT", "questions": [{"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}]}], "template_override": 1, "id": 10, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"stimuli_ids": [], "type": "DWS", "questions": [{"responses": [{"correct": 1, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le08ob05re7pdf01.pdf"}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nRetell a legend from the indigenous people of your country.\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le08ob05re2img01.jpg", "audiosrc": "engenn9le08ob05re2aud01", "images": [{"time": "0", "image": "engenn9le08ob05re2img01.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn9le08ob05re2img01.jpg", "text": "In the beginning there was nothing on the earth. There were many powerful spirits in the air. One spirit was more powerful than all the rest. The other spirits were feeling jealous, so they rebelled against him.<br/><br/>He felt great anger, so he crushed them. He refashioned them into rock and stone and fire. They became mountains and volcanoes.<br/><br/>He was kind to those who did not rebel. He changed them into fiery objects, and he cast them into the heavens to become pulsing stars.", "id": 1}, {"time": "38000", "image": "engenn9le08ob05re2img02.jpg", "text": "While the spirit was talking to his son, he decided to honor him. He turned him into a man and sent him to the earth. Later, when he realized his son was lonely, the powerful spirit took a star and carefully sculpted it into a woman. <br/><br/>Then, while he was watching the woman walk the barren earth, he decided to grow grass and flowers to protect her feet.<br/><br/>Whenever the woman touched a flower, it turned into a bird or a butterfly.Whenever the woman walked through a field, a huge jungle appeared after her.", "id": 2}, {"time": "76000", "image": "engenn9le08ob05re2img03.jpg", "text": "The man and the woman were walking one day when they found each other. They saw that the earth was beautiful. In the daylight hours, the powerful spirit was always watching them through a round window high in the sky.<br/><br/>At night, the man's mother was watching over them through the same window. This is how the mountains, volcanos, man, woman, the sun, and the moon came to be.", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Storytelling"}, {"type": "unit_name", "content": "A Chilean Myth"}, {"type": "position", "content": 5}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 8}, {"type": "level", "content": "B2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe hypothetical situations in written and spoken interactions according to social contexts."}, {"type": "secondary_1", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_2", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}, {"type": "secondary_3", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_4", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}, {"type": "secondary_5", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}, {"type": "secondary_6", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_7", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}, {"type": "secondary_8", "content": "nderstands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. "}]}, {"type": "background_image", "content": "engenn9le08ob05re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Simple Past Tense"}, {"type": "describer", "content": "You use the Simple Past tense to talk about many kinds of past events: short, quickly finished actions, longer situations and repeated events. "}, {"type": "text", "content": "Usually, when you use the Simple Past tense, the time of the finished action is clear from the context or explicitly mentioned in the sentence."}, {"type": "text", "content": "For example:<br/><span class=\"italic\">In the 1980s, scientists <span class=\"strong\">recognized</span> that human actions had a negative effect on the global ozone layer.</span>"}, {"type": "text", "content": "Here, it is clear when the action of \u201crecognizing\u201d happened (in the 1980s) and that it finished in that time period. "}, {"type": "text", "content": "Here is another example:<br/><span class=\"italic\">However, in 1985, they <span class=\"strong\">discovered</span> a large hole in the ozone that is growing above Antarctica.</span>"}, {"type": "text", "content": "You also use the Simple Past tense with the Past Continuous tense to talk about the action that interrupted another action in progress a particular time in the past."}, {"type": "text", "content": "For example: <br/><span class=\"italic\">While the spirit was talking to his son, he <span class=\"strong\">decided</span> to honor him.</span>"}, {"type": "text", "content": "Here, the action of \u201cdeciding\u201d interrupts the \u201ctalking\u201d, so you use the Simple Past tense. "}, {"type": "text", "content": "Remember that there are both regular and irregular verbs. Look at the chart for examples of the Simple Past tense verbs."}, {"type": "text", "content": "<span class=\"strong\">Regular Verbs</span>:"}, {"type": "table", "content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"decide\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"decided\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"realize\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"realized\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "<span class=\"strong\">Irregular Verbs</span>:"}, {"type": "table", "content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"are\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"were\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"take\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"took\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "He was kind to those who did not rebel."}, {"type": "example", "content": "He changed them into fiery objects, and he cast them into the heavens to become pulsing stars."}, {"type": "example", "content": "He felt great anger, so he crushed them. "}, {"type": "example", "content": "He refashioned them into rock and stone and fire. "}, {"type": "example", "content": "They became mountains and volcanoes."}, {"type": "example", "content": "While the spirit was talking to his son, he decided to honor him. "}, {"type": "example", "content": "He turned him into a man and sent him to the earth."}, {"type": "example", "content": "Later, when he realized his son was lonely, the powerful spirit took a star and carefully sculpted it into a woman. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "spirit "}, {"type": "definition", "content": "an intangible being inhabiting or embodying a particular place, object, or natural phenomenon"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There were many powerful spirits in the air."}, {"type": "audio", "content": "engenn9le08ob05aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you hear in a Chilean creation myth."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to refashion"}, {"type": "definition", "content": "to remake"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: He refashioned them into rock and stone and fire. "}, {"type": "audio", "content": "engenn9le08ob05aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to crush"}, {"type": "definition", "content": "to press or squeeze something so hard that it breaks or loses its shape"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: He felt great anger, so he crushed them."}, {"type": "audio", "content": "engenn9le08ob05aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "fiery"}, {"type": "definition", "content": "burning and glowing"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: He changed those who were not rebels  into fiery objects."}, {"type": "audio", "content": "engenn9le08ob05aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to pulse"}, {"type": "definition", "content": "to beat steadily"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: He cast them into the heavens to become pulsing stars."}, {"type": "audio", "content": "engenn9le08ob05aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to sculpt"}, {"type": "definition", "content": "to shape or mold"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: The powerful spirit took a star and carefully sculpted it into a woman"}, {"type": "audio", "content": "engenn9le08ob05aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Go online or to the library and find a legend from your country that you like."}, {"type": "text", "content": "Read the story and make a list of words that will help you retell it."}, {"type": "text", "content": "Put the story away and try to write the story in your own words, using the words you selected."}, {"type": "text", "content": "When you have finished, compare the two stories."}, {"type": "text", "content": "Note things you have left out."}, {"type": "text", "content": "Bring the story to class and tell it to a partner. After you have finished explain why you chose that particular story."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I find a legend from my country."}, {"type": "text", "content": "I read it and make a word list."}, {"type": "text", "content": "I put the story away and write it in my own words."}, {"type": "text", "content": "I check my story against the original and note anything I missed."}, {"type": "text", "content": "I retell the story to a partner and explain why I chose it."}]}]}