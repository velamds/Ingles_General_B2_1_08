: 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn9le08ob09re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "\nFind out about mirrors in folk and fairy tales.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn9le08ob09re2aud01", "coverimg": "engenn9le08ob09re2img01.jpg", "images": [{"image": "engenn9le08ob09re2img01.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn9le08ob09re2img01.jpg", "text": "Here is another folk tale that has been told many times.<br/>It's long ago, in Japan. A man lives there with his wife and daughter. One day, the woman  becomes very ill. When her daughter has been brought to her, she asks her to make sure that her father is  being taken care of. Then, the child cries as she is being given a mirror.<br/><br/>Her mother explains that whenever she felt sad and lonely, she would look into the mirror. She says that she would see her mother's face. She adds that she would see her as she had been when she was young.", "time": "100", "id": 1}, {"image": "engenn9le08ob09re2img02.jpg", "text": "After her mother dies, the young girl misses her. Eventually, she is standing at the temple while her father is being married once again. His new wife abhors the young girl. She is being consumed with jealousy.<br/><br/>The new wife sees the girl looking into the mirror. She tells her husband his daughter was trying to kill her. She hisses that the daughter was using evil magic!", "time": "40000", "id": 2}, {"image": "engenn9le08ob09re2img03.jpg", "text": "The angry father asks his daughter why she was trying to kill her stepmother!<br/><br/>The daughter replies that she wasn't trying to kill his new wife. She was only looking in the mirror she has been given by her mother.<br/><br/>We know the message has been conveyed, because the father and stepmother both feel ashamed ... From that day forth, they live together in peace. Whenever the girl wants to see her mother, she looks in the mirror.", "time": "69000", "id": 3}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "type": "sena"}